                  .
                </p>
              </div>
            </div>
          </div>
        </div>
      </main>
      <div
        class="HotbarMenu flex column"
        data-testid="hotbar-rail"
      >
        <button
          class="HotbarCollapse"
          data-testid="hotbar-collapse"
          title="Collapse favorites bar"
          type="button"
        >
          <i
            class="Icon material focusable"
          >
            <span
              class="icon"
              data-icon-name="chevron_left"
            >
              chevron_left
            </span>
          </i>
        </button>
        <div
          class="HotbarItems flex column gaps"
          data-testid="hotbar-items-scroll"
        >
          <div
            class="HotbarCell animateDown"
            index="0"
          >
            <div
              data-rbd-draggable-id="favorite-0"
              style="z-index: 1; position: absolute;"
            >
              <div
                class="HotbarIcon contextMenuAvailable"
                data-testid="hotbar-pin"
                id="hotbarPin-hotbar-icon-catalog-entity"
              >
                <div
                  class="Avatar rounded disabled avatar"
                  id="hotbarIcon-hotbar-icon-catalog-entity"
                  style="width: 36px; height: 36px; background: rgb(5, 1, 130);"
                >
                  Ca
                </div>
                <span
                  class="label"
                  title="Catalog"
                >
                  Catalog
                </span>
              </div>
            </div>
          </div>
          <div
            class="HotbarCell animateDown"
            index="1"
          />
          <div
            class="HotbarCell animateDown"
            index="2"
          />
          <div
            class="HotbarCell animateDown"
            index="3"
          />
          <div
            class="HotbarCell animateDown"
            index="4"
          />
          <div
            class="HotbarCell animateDown"
            index="5"
          />
          <div
            class="HotbarCell animateDown"
            index="6"
          />
          <div
            class="HotbarCell animateDown"
            index="7"
          />
          <div
            class="HotbarCell animateDown"
            index="8"
          />
          <div
            class="HotbarCell animateDown"
            index="9"
          />
          <div
            class="HotbarCell animateDown"
            index="10"
          />
          <div
            class="HotbarCell animateDown"
            index="11"
          />
        </div>
        <div
          class="HotbarSelector"
        >
          <i
            class="Icon material interactive focusable"
            tabindex="0"
          >
            <span
              class="icon"
              data-icon-name="arrow_left"
            >
              arrow_left
            </span>
          </i>
          <div
            class="HotbarIndex"
          >
            <div
              class="badge Badge small clickable"
              data-testid="hotbar-menu-badge-for-default"
              id="hotbarIndex"
            >
              1
            </div>
          </div>
          <i
            class="Icon material interactive focusable"
            tabindex="0"
          >
            <span
              class="icon"
              data-icon-name="arrow_right"
            >
              arrow_right
            </span>
          </i>
        </div>
      </div>
      <div
        class="StatusBar"
        data-testid="status-bar"
      >
        <div
          class="leftSide"
          data-testid="status-bar-left"
        />
        <div
          class="rightSide"
          data-testid="status-bar-right"
        />
      </div>
    </div>
    <div
      class="Notifications flex column align-flex-end"
    />
  </div>
</body>
`;
