            class="Icon material focusable"
          >
            <span
              class="icon"
              data-icon-name="chevron_left"
            >
              chevron_left
            </span>
          </i>
        </button>
        <div
          class="HotbarItems flex column gaps"
        >
          <div
            class="HotbarCell animateDown"
            index="0"
          >
            <div
              data-rbd-draggable-id="favorite-0"
              style="z-index: 1; position: absolute;"
            >
              <div
                class="HotbarIcon contextMenuAvailable"
                data-testid="hotbar-pin"
              >
                <div
                  class="Avatar rounded disabled avatar"
                  id="hotbarIcon-hotbar-icon-catalog-entity"
                  style="width: 56px; height: 56px; background: rgb(5, 1, 130);"
                >
                  Ca
                </div>
              </div>
            </div>
          </div>
          <div
            class="HotbarCell animateDown"
            index="1"
          />
        </div>
      </div>
      <div
        class="StatusBar"
        data-testid="status-bar"
      >
        <div
          class="leftSide"
          data-testid="status-bar-left"
        />
        <div
          class="rightSide"
          data-testid="status-bar-right"
        />
      </div>
    </div>
    <div
      class="Notifications flex column align-flex-end"
    />
  </div>
</body>
`;
