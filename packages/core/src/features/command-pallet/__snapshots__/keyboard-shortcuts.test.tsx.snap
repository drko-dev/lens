                    points="11 1.576 6.583 6 11 10.424 10.424 11 6 6.583 1.576 11 1 10.424 5.417 6 1 1.576 1.576 1 6 5.417 10.424 1"
                  />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
      <main>
        <div
          class="WorkspaceTabBar"
          data-testid="workspace-tab-bar"
        >
          <div
            class="workspace-header-controls"
          >
            <div
              class="workspace-indicator"
              title="Workspace: default"
            >
              <i
                class="Icon ws-icon material focusable"
              >
                <span
                  class="icon"
                  data-icon-name="dashboard"
                >
                  dashboard
                </span>
              </i>
              <select
                aria-label="Select workspace"
                data-testid="workspace-selector"
              >
                <option
                  value="default"
                >
                  Default Workspace
                </option>
              </select>
            </div>
            <button
              aria-label="Create workspace"
              data-testid="workspace-create"
              title="Create workspace"
              type="button"
            >
              <i
                class="Icon material focusable"
              >
                <span
                  class="icon"
                  data-icon-name="add"
                >
                  add
                </span>
              </i>
            </button>
            <div
              aria-label="Workspace history navigation"
              class="workspace-nav-controls"
              role="group"
            >
              <button
                aria-label="Go back in workspace history"
                class="nav-btn nav-back"
                data-testid="workspace-nav-back"
                disabled=""
                title="Go back (Alt+Left)"
                type="button"
              >
                <i
                  class="Icon material focusable"
                >
                  <span
                    class="icon"
                    data-icon-name="chevron_left"
                  >
                    chevron_left
                  </span>
                </i>
              </button>
              <button
                aria-label="Go forward in workspace history"
                class="nav-btn nav-forward"
                data-testid="workspace-nav-forward"
                disabled=""
                title="Go forward (Alt+Right)"
                type="button"
              >
                <i
                  class="Icon material focusable"
                >
                  <span
                    class="icon"
                    data-icon-name="chevron_right"
                  >
                    chevron_right
                  </span>
                </i>
              </button>
            </div>
          </div>
          <div
            aria-label="Kubernetes cluster tabs"
            class="tabs-scroll-container"
            role="tablist"
          />
        </div>
        <div
          class="with-tab-bar"
          id="lens-views"
        />
        <div
          class="flex justify-center Welcome align-center"
          data-testid="welcome-page"
        >
          <div
            data-testid="welcome-banner-container"
            style="width: 320px;"
          >
            <img
              alt="OpenLens DevOps"
              class="logo devops-brand"
              data-testid="openlens-devops-brand-icon"
              draggable="false"
              src=""
            />
            <div
              class="flex justify-center"
            >
              <div
                data-testid="welcome-text-container"
                style="width: 320px;"
              >
                <h2>
                  some-product-name
                </h2>
                <p
                  class="purpose"
                >
                  Your local workspace for Kubernetes clusters. Nothing connects until you open a cluster.
                </p>
                <div
                  class="actions"
                >
                  <button
                    class="primary"
                    data-testid="welcome-launch-demo-cluster"
                  >
                    Launch demo cluster
                  </button>
                  <button
                    data-testid="welcome-open-catalog"
                  >
                    Open catalog
                  </button>
                  <button
                    data-testid="welcome-add-cluster"
                  >
                    Add cluster
                  </button>
                </div>
                <div
                  class="summary"
                  data-testid="welcome-workspace-summary"
                >
                  <span>
                    0 clusters
                  </span>
                  <span>
                    1 pinned
                  </span>
                </div>
                <ul
                  class="block"
                  data-testid="welcome-menu-container"
                  style="width: 320px;"
                >
                  <li
                    class="flex grid-12"
                  >
                    <i
                      class="Icon box col-1 material focusable"
                    >
                      <span
                        class="icon"
                        data-icon-name="view_list"
                      >
                        view_list
                      </span>
                    </i>
                    <a
                      class="box col-10"
                    >
                      Browse Clusters in Catalog
                    </a>
                    <i
                      class="Icon box col-1 material focusable"
                    >
                      <span
                        class="icon"
                        data-icon-name="navigate_next"
                      >
                        navigate_next
                      </span>
                    </i>
                  </li>
                </ul>
                <p
                  class="footer"
                >
                  Questions or feedback? Join the 
                  <a
                    class="link"
                    href="https://forums.k8slens.dev"
                    rel="noreferrer"
                    target="_blank"
                  >
                    Lens Forums
                  </a>
                  .
                </p>
              </div>
            </div>
          </div>
        </div>
      </main>
      <div
        class="HotbarMenu flex column"
        data-testid="hotbar-rail"
      >
        <button
          class="HotbarCollapse"
          data-testid="hotbar-collapse"
          title="Collapse favorites bar"
          type="button"
        >
          <i
            class="Icon material focusable"
          >
            <span
              class="icon"
              data-icon-name="chevron_left"
            >
              chevron_left
            </span>
          </i>
        </button>
        <div
          class="HotbarItems flex column gaps"
        >
          <div
            class="HotbarCell animateDown"
            index="0"
          >
            <div
              data-rbd-draggable-id="favorite-0"
              style="z-index: 1; position: absolute;"
            >
              <div
                class="HotbarIcon contextMenuAvailable"
                data-testid="hotbar-pin"
              >
                <div
                  class="Avatar rounded disabled avatar"
                  id="hotbarIcon-hotbar-icon-catalog-entity"
                  style="width: 56px; height: 56px; background: rgb(5, 1, 130);"
                >
                  Ca
                </div>
              </div>
            </div>
          </div>
          <div
            class="HotbarCell animateDown"
            index="1"
          />
        </div>
      </div>
      <div
        class="StatusBar"
        data-testid="status-bar"
      >
        <div
          class="leftSide"
          data-testid="status-bar-left"
        />
        <div
          class="rightSide"
          data-testid="status-bar-right"
        />
      </div>
    </div>
    <div
      class="Notifications flex column align-flex-end"
    />
  </div>
  <div
    class="Dialog flex center"
  >
    <div
      class="box"
    >
      <div
        class="CommandContainer"
        data-testid="command-container"
      />
    </div>
  </div>
</body>
`;

